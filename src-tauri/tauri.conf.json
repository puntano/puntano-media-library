{
  "$schema": "https://schema.tauri.app/v2/config",
  "productName": "Puntano Media Library",
  "version": "0.4.2",
  "identifier": "com.puntano.medialibrary",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Puntano Media Library",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' asset: http://asset.localhost blob: data: https: puntano-thumb: http://puntano-thumb.localhost; worker-src 'self' blob:; child-src 'self' blob:; img-src 'self' data: blob: http: https: asset: http://asset.localhost puntano-thumb: http://puntano-thumb.localhost; connect-src 'self' http: https: blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3MUFBOURCNjE3ODVEMwpSV1RUaFJlMm5hcHhCT1lQK0NyK3NFNmt2T3JUSEloQmJ3RGVkVW1FZENxZ2NJclBqM2NhazFMQwo=",
      "endpoints": [
        "https://github.com/puntano/puntano-media-library/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
